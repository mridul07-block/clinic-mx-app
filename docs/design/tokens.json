{
  "$description": "Design system v2 (ink and gold) from the Clinic Mx demo. Same values as css/tokens.css. Format: W3C design tokens draft ($value, $type).",
  "color": {
    "surface": {
      "canvas":   { "$value": "#F7F5F3", "$type": "color", "$description": "App frame and sidebar, behind the sheet" },
      "surface":  { "$value": "#FFFFFF", "$type": "color", "$description": "The sheet, panels, drawers" },
      "subtle":   { "$value": "#FAF9F7", "$type": "color", "$description": "Table header band, panel and drawer footers" },
      "hover":    { "$value": "#F4F2EF", "$type": "color", "$description": "Row and item hover" },
      "sunken":   { "$value": "#EFEDEA", "$type": "color", "$description": "Wells, machine slots, tracks, skeletons, avatars" }
    },
    "line": {
      "line":     { "$value": "#E6E3DF", "$type": "color", "$description": "Hairlines, panel borders, grid lines" },
      "strong":   { "$value": "#D3D0CC", "$type": "color", "$description": "Dividers, secondary button borders" },
      "control":  { "$value": "#8C8984", "$type": "color", "$description": "Input, select and checkbox borders; 3:1 on white" }
    },
    "ink": {
      "ink":       { "$value": "#1B1915", "$type": "color", "$description": "Text" },
      "secondary": { "$value": "#45423D", "$type": "color", "$description": "Secondary text" },
      "muted":     { "$value": "#66635D", "$type": "color", "$description": "Labels, meta, axes, chart cells; 6:1 on white" },
      "faint":     { "$value": "#8F8C86", "$type": "color", "$description": "Placeholders and disabled text only, never meaning" }
    },
    "brand": {
      "brand":    { "$value": "#FCB813", "$type": "color", "$description": "Movementology gold. A mark and a fill only, never text (1.7:1 on white)" },
      "deep":     { "$value": "#BB8503", "$type": "color", "$description": "Gold icons that must reach 3:1" },
      "on-brand": { "$value": "#1B1915", "$type": "color", "$description": "Text on gold (10:1)" }
    },
    "accent": {
      "accent":    { "$value": "#1B1915", "$type": "color", "$description": "Primary buttons, selection, links" },
      "hover":     { "$value": "#35322E", "$type": "color", "$description": "Primary button hover" },
      "soft":      { "$value": "#F0EEEB", "$type": "color", "$description": "Selected row, quiet button hover" },
      "on-accent": { "$value": "#FFFFFF", "$type": "color", "$description": "Text on the accent" }
    },
    "focus": { "$value": "#2171CC", "$type": "color", "$description": "Focus ring, 2px solid, 2px offset; 4.9:1 on white" },
    "status": {
      "info":    { "text": { "$value": "#2460A8", "$type": "color" }, "soft": { "$value": "#EBF6FF", "$type": "color" }, "line": { "$value": "#B7D4F9", "$type": "color" } },
      "waiting": { "text": { "$value": "#8A5100", "$type": "color" }, "soft": { "$value": "#FFF3D3", "$type": "color" }, "line": { "$value": "#F0CB8D", "$type": "color" }, "strong": { "$value": "#BB7400", "$type": "color" } },
      "active":  { "text": { "$value": "#1D7339", "$type": "color" }, "soft": { "$value": "#EBF9ED", "$type": "color" }, "line": { "$value": "#B6DDBD", "$type": "color" } },
      "done":    { "text": { "$value": "#5A5853", "$type": "color" }, "soft": { "$value": "#F1F0ED", "$type": "color" }, "line": { "$value": "#D3D0CC", "$type": "color" } },
      "danger":  { "text": { "$value": "#AC2724", "$type": "color" }, "soft": { "$value": "#FFEFED", "$type": "color" }, "line": { "$value": "#F6C3BC", "$type": "color" }, "strong": { "$value": "#B7191C", "$type": "color" }, "on-danger": { "$value": "#FFFFFF", "$type": "color" } }
    },
    "viz": {
      "series-1":  { "$value": "#1B6AB6", "$type": "color", "$description": "Main chart series (blue, never the ink accent)" },
      "compare":   { "$value": "#CAC7C2", "$type": "color", "$description": "Previous period, other series behind the one in focus" },
      "target":    { "$value": "#66635D", "$type": "color", "$description": "Target lines, 1px dashed" },
      "category-1": { "$value": "#2F74BB", "$type": "color", "$description": "Blue (centre 1)" },
      "category-2": { "$value": "#7F5BB6", "$type": "color", "$description": "Violet (centre 2)" },
      "category-3": { "$value": "#1C8580", "$type": "color", "$description": "Teal (centre 3)" },
      "promoter":  { "$value": "#2F74BB", "$type": "color" },
      "passive":   { "$value": "#CDCAC5", "$type": "color" },
      "detractor": { "$value": "#D8662A", "$type": "color" },
      "ramp": {
        "1": { "$value": "#EAF5FF", "$type": "color" },
        "2": { "$value": "#C7E1FF", "$type": "color" },
        "3": { "$value": "#9FC8F7", "$type": "color" },
        "4": { "$value": "#73ACEB", "$type": "color" },
        "5": { "$value": "#4C8FD8", "$type": "color" },
        "6": { "$value": "#2773C0", "$type": "color" },
        "7": { "$value": "#0E599D", "$type": "color" }
      }
    },
    "scrim": { "$value": "rgba(27, 25, 21, 0.40)", "$type": "color", "$description": "Only behind confirm dialogs" }
  },
  "font": {
    "family": {
      "sans": { "$value": "'IBM Plex Sans Variable', 'IBM Plex Sans', system-ui, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$type": "fontFamily" }
    },
    "weight": {
      "normal":   { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" }
    }
  },
  "typography": {
    "xs":      { "$type": "typography", "$value": { "fontSize": "12px", "lineHeight": "16px" } },
    "sm":      { "$type": "typography", "$value": { "fontSize": "13px", "lineHeight": "18px" } },
    "base":    { "$type": "typography", "$value": { "fontSize": "14px", "lineHeight": "20px" } },
    "md":      { "$type": "typography", "$value": { "fontSize": "16px", "lineHeight": "24px" } },
    "lg":      { "$type": "typography", "$value": { "fontSize": "18px", "lineHeight": "26px" } },
    "xl":      { "$type": "typography", "$value": { "fontSize": "22px", "lineHeight": "30px" } },
    "2xl":     { "$type": "typography", "$value": { "fontSize": "28px", "lineHeight": "36px" } },
    "title":   { "$type": "typography", "$value": { "fontSize": "24px", "lineHeight": "32px", "letterSpacing": "-0.015em", "fontWeight": 600 } },
    "display": { "$type": "typography", "$value": { "fontSize": "32px", "lineHeight": "40px", "letterSpacing": "-0.02em", "fontWeight": 600 } }
  },
  "radius": {
    "control": { "$value": "6px", "$type": "dimension" },
    "tag":     { "$value": "6px", "$type": "dimension" },
    "checkbox": { "$value": "4px", "$type": "dimension" },
    "panel":   { "$value": "12px", "$type": "dimension" },
    "sheet":   { "$value": "14px", "$type": "dimension" },
    "drawer":  { "$value": "16px", "$type": "dimension" }
  },
  "shadow": {
    "xs":     { "$value": "0 1px 2px rgb(27 25 21 / 5%)", "$type": "shadow" },
    "float":  { "$value": "0 12px 32px -8px rgb(27 25 21 / 18%), 0 2px 6px rgb(27 25 21 / 6%)", "$type": "shadow" },
    "drawer": { "$value": "-24px 0 48px -16px rgb(27 25 21 / 18%), -1px 0 0 rgb(27 25 21 / 4%)", "$type": "shadow" }
  },
  "size": {
    "row":            { "$value": "36px", "$type": "dimension", "$description": "Controls and table rows with a mouse" },
    "row-touch":      { "$value": "44px", "$type": "dimension", "$description": "Controls and rows on touch screens" },
    "target-patient": { "$value": "56px", "$type": "dimension", "$description": "Kiosk and patient pages" },
    "answer":         { "$value": "64px", "$type": "dimension", "$description": "Kiosk Yes / No" },
    "sidebar":        { "$value": "240px", "$type": "dimension" },
    "rail":           { "$value": "64px", "$type": "dimension" },
    "drawer":         { "$value": "480px", "$type": "dimension" }
  },
  "spacing": { "$description": "4px steps", "$value": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64] },
  "motion": {
    "quick":  { "$value": "120ms", "$type": "duration", "$description": "Hover and press" },
    "motion": { "$value": "240ms", "$type": "duration", "$description": "Drawers, toasts, chart changes" },
    "ease-standard": { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" }
  },
  "z": { "drawer": 30, "dialog": 40, "popover": 50, "toast": 60, "lock": 70 }
}
