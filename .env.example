# Clinic Mx environment variables. Copy to apps/web/.env.local for local development.
# Never commit real values (rule 13). Validated in apps/web/lib/env.ts.
#
# Set automatically by Vercel on every deployment; leave unset locally:
#   VERCEL_ENV             production | preview | development
#   VERCEL_REGION          function region, bom1 (Mumbai)
#   VERCEL_GIT_COMMIT_SHA  commit of the deployment
#
# Vercel build settings (project environment variables, all environments):
#   ENABLE_EXPERIMENTAL_COREPACK=1   use the pnpm version from package.json "packageManager"
#
# Later tickets add their variables below (Resend IAM-01, Cloudflare FND-05/09,
# Sentry FND-12, backups FND-13).

# Supabase: staging project "Clinic Mx", region ap-south-1 (Mumbai). Server only: the browser
# never calls supabase.co (rule 9). Where to find each value: docs/runbooks/supabase.md.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Transaction pooler, port 6543: the app at runtime.
DATABASE_URL=
# Session pooler, port 5432: migrations (not "Direct connection", which is IPv6 only).
DIRECT_DATABASE_URL=
# Personal access token for the Supabase CLI.
SUPABASE_ACCESS_TOKEN=

# Job tick (FND-10): pg_cron sends this with every tick to /api/jobs/tick. At least 32 random
# characters; the same value is stored in Supabase Vault as jobs_tick_secret (docs/runbooks/jobs.md).
JOBS_SECRET=

# Patient links (IAM-09): signs every /p/<token> link. At least 32 random characters, different per
# environment. To rotate: move the value to PATIENT_LINK_SECRET_PREVIOUS, set a new one, and clear
# the previous one once the longest link lifetime (links.my_plan_days) has passed.
PATIENT_LINK_SECRET=
PATIENT_LINK_SECRET_PREVIOUS=

# Seed (pnpm db:seed) writes test centres and staff to DIRECT_DATABASE_URL. It runs only when
# this is "local" or "staging", so production never gets test staff.
CLINIC_MX_SEED_TARGET=
# With SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY also set, the seed gives every test staff member
# a login with this password (IAM-01). At least 12 characters; never a real person's password.
CLINIC_MX_SEED_STAFF_PASSWORD=

# Developer machine only, never read by the app: a Vercel access token scoped to the
# clinic-mx-app project, used to set the project's environment variables (expires; renew).
VERCEL_TOKEN=
