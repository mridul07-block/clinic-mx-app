{
  "name": "clinic-mx",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "eslint . --max-warnings 0",
    "check:design": "pnpm --filter @clinic-mx/ui check:design",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase",
    "db:start": "supabase start -x studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:generate": "pnpm --filter @clinic-mx/db db:generate",
    "db:seed": "pnpm --filter @clinic-mx/db db:seed",
    "kb:import": "pnpm --filter @clinic-mx/db kb:import"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-security": "4.2.0",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
